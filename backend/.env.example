# ===== LLM（OpenAI 兼容接口，纯对话智能体）=====
# 模型 id（示例值，请替换为你自己的模型 id）
LLM_MODEL=<your-model-id>
LLM_MODEL_ID=<your-model-id>
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=sk-xxxxxxxx

# ===== LangSmith 追踪（不配置则不开启上报）=====
# LANGSMITH_API_KEY=lsv2-xxxxxxxx
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=AskData_Agent

# ===== 记忆存储（PostgreSQL，本地 Docker：docker compose up -d）=====
DATABASE_URL=postgresql://askdata:askdata@localhost:5432/askdata_memory

# ===== 后端 =====
# ASK_DATA_SECRET=change-me-in-prod
