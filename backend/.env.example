# ===== LLM（DeepSeek，OpenAI 兼容接口；不配置则走模板降级引擎）=====
DEEPSEEK_API_KEY=sk-xxxxxxxx
# 或使用 OpenAI：
# OPENAI_API_KEY=sk-xxxxxxxx

# 模型与接口地址（默认 DeepSeek，可改任意 OpenAI 兼容端点）
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ===== LangSmith 追踪（不配置则不开启上报）=====
LANGSMITH_API_KEY=lsv2-xxxxxxxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=AskData_Agent

# ===== 后端 =====
# ASK_DATA_SECRET=change-me-in-prod
